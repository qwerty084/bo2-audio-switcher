<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BO2 Audio" Icon="app.ico" Width="480" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- One output device: a radio button drawn as a full-width row -->
        <Style x:Key="DeviceRow" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="MinHeight" Value="60" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Back" CornerRadius="6" BorderThickness="1"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" />
                            <Border x:Name="Hover" CornerRadius="6" Opacity="0"
                                    Background="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Border x:Name="Tint" CornerRadius="6" Opacity="0"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Border x:Name="Ring" CornerRadius="6" BorderThickness="1" Opacity="0"
                                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" />
                            <ContentPresenter Margin="16,8" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.05" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.09" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tint" Property="Opacity" Value="0.14" />
                                <Setter TargetName="Ring" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24,12,24,16">
        <!-- Devices -->
        <StackPanel x:Name="MainView">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="Dot" Width="10" Height="10" Margin="0,1,10,0" VerticalAlignment="Center" />
                <TextBlock x:Name="Status" Style="{StaticResource Secondary}" FontSize="13" />
            </StackPanel>
            <ProgressBar x:Name="Level" Height="4" Minimum="0" Maximum="1" Margin="0,12,0,0"
                         ToolTip="Moves while the game makes sound" />

            <TextBlock x:Name="Heading" Style="{StaticResource Heading}" Margin="0,20,0,0" />
            <TextBlock x:Name="Hint" Style="{StaticResource Secondary}" FontSize="13" Margin="0,4,0,0" />
            <StackPanel x:Name="Rows" Margin="0,10,0,0" />

            <TextBlock x:Name="Problem" TextWrapping="Wrap" Margin="0,6,0,0"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" />

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ShortcutLine" Style="{StaticResource Secondary}" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Hyperlink Click="OpenSettings">Settings</Hyperlink>
                </TextBlock>
            </Grid>
        </StackPanel>

        <!-- Settings -->
        <StackPanel x:Name="SettingsView" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Margin="-8,0,0,0">
                <Button Click="CloseSettings" Width="40" Height="36" Padding="0" Background="Transparent" BorderThickness="0"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="&#xE72B;"
                        ToolTip="Back" AutomationProperties.Name="Back" />
                <TextBlock Text="Settings" Style="{StaticResource Heading}" VerticalAlignment="Center" Margin="6,0,0,0" />
            </StackPanel>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <Grid Margin="16,10,12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Keyboard shortcut" />
                            <TextBlock Text="Switch to the next device without leaving the game"
                                       Style="{StaticResource Secondary}" FontSize="12" />
                        </StackPanel>
                        <CheckBox x:Name="ShortcutOn" Grid.Column="1" MinWidth="0" VerticalAlignment="Center"
                                  Click="ShortcutOnClick" AutomationProperties.Name="Keyboard shortcut" />
                    </Grid>
                    <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <Grid Margin="16,10,12,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Keys" />
                                <TextBlock x:Name="KeysHelp" Style="{StaticResource Secondary}" FontSize="12" />
                            </StackPanel>
                            <Button x:Name="KeysButton" Grid.Column="1" MinWidth="130" VerticalAlignment="Center"
                                    Click="KeysClick" LostKeyboardFocus="KeysLostFocus" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Text="The shortcut switches between" FontWeight="SemiBold" Margin="0,16,0,8" />
            <Border Style="{StaticResource Card}" Padding="16,6,12,6">
                <StackPanel x:Name="CycleRows" />
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,4">
                <Grid Margin="16,10,12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Beep on the new device after a shortcut switch" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <CheckBox x:Name="BeepOn" Grid.Column="1" MinWidth="0" VerticalAlignment="Center"
                              Click="BeepOnClick" AutomationProperties.Name="Beep after a shortcut switch" />
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Window>
